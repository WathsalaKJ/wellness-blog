# Redirect to HTTPS (skip on local dev)
   RewriteEngine On
   RewriteCond %{HTTPS} off
   RewriteCond %{HTTP_HOST} !^localhost [NC]
   RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
   
   # Hide .php extension
   RewriteCond %{REQUEST_FILENAME} !-d
   RewriteCond %{REQUEST_FILENAME}\.php -f
   RewriteRule ^(.*)$ $1.php [NC,L]
   
   # Prevent directory browsing
   Options -Indexes
   
   # Protect sensitive files
   <FilesMatch "^\.env$">
     Require all denied
   </FilesMatch>
   
   # PHP settings (upload limits, session cookie hardening) live in php.ini
   # at the project root, not here: InfinityFree runs PHP via CGI, and
   # php_value/php_flag in .htaccess cause a 500 error under CGI PHP.